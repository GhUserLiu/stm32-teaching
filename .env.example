# ============================================================
# Copy to .env (repo root) and adjust per machine.
# .env itself is gitignored; this template stays tracked.
# Optional: pip install python-dotenv to auto-load it;
# plain OS environment variables work without that dependency.
# ============================================================

# Environment overlay applied on top of config/base.yaml (dev | prod | base)
APP_ENV=base

# Override convention: APP_<SECTION>__<FIELD> (double underscore = nesting)
# Examples (uncomment and adjust):
# APP_TEACHING__SEMESTER=2026-秋季
# APP_GRADING__TOOLCHAIN__KEIL_ENABLED=true
# APP_GRADING__TOOLCHAIN__KEIL_UV4_PATH=C:\Keil_v5\UV4\UV4.exe
