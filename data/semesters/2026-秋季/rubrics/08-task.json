      ]
    },

    {
      "id": "build", "name": "编译检查", "points": 15, "grading_method": "build",
      "source_section": "源代码工程",
      "description": "对真实源码工程执行编译，编译通过得满分；失败不得分",
      "note": "由 BuildChecker 实际编译评定；工具链缺失时记 SKIPPED 并排除出总分"
    },
    {
      "id": "non_blocking", "name": "非阻塞设计（HAL_Delay 禁用）", "points": 5, "grading_method": "source_check",
      "source_section": "源代码工程",
      "forbid_patterns": ["HAL_Delay\\s*\\("],
      "penalty_per_hit": 3,
      "note": "主循环应非阻塞调度；传感器驱动时序内的微秒/毫秒级延时属正常实现，不计违规"
    },
    {
      "id": "code_quality", "name": "代码质量", "points": 20, "grading_method": "code_analysis",
      "source_section": "源代码工程",
      "description": "静态分析：模块划分、命名规范、注释",
      "criteria": [
        {"description": "结构清晰（初始化/主循环分离）", "points": 7},
        {"description": "命名规范", "points": 7},
        {"description": "注释与可读性", "points": 6}
      ]
    },

    {
      "id": "task_check", "name": "任务检查（教师）", "points": 25, "grading_method": "manual",
      "default_points": 20,
      "source_section": "教师评定",
      "description": "按当日检查表现场评定（功能演示、数据记录质量、回答提问）；未填写时自动按 25×0.8=20 分预置，教师可随时调整"
    }
  ],

  "reference_answers": {
    "submission": "每次小任务：1份实验报告(.docx) + 1份源码zip（Makefile+common-f1 工程形态）",
    "pin_map_hint": "统一见接线方案：DHT11=PB12 热敏=PA6 光敏=PA4 OLED=PB6/PB7 蜂鸣器=PB5 TB6612=PB0/PB1/PA8"
  },

  "common_issues": [
    "报告只贴图无文字说明（关键词匹配不到）",
    "源码未带 Makefile/common-f1（编译 0 分）",
    "数据记录只有一次测量，无对比分析",
    "主循环 HAL_Delay 阻塞（演示时按键/OLED 卡顿）"
  ]
