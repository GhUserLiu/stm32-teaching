  "reference_answers": {
    "state_machine": "状态+事件+转换三要素；任务一(关闭/左转/右转/双闪/迎宾/紧急)，任务二(手动/报警)，任务三(正常/设置闹钟/闹钟触发/查询)",
    "non_blocking": "基于 HAL_GetTick() 记录上次执行时间，差值达周期才执行；主循环 <10ms；严禁 HAL_Delay",
    "task1_key": "短按循环(关闭/左转/右转/双闪)、长按>1s迎宾(交替慢闪3次后恢复)、KEY_UP紧急双闪(最高优先级,再按恢复)",
    "task2_key": "ADC1 ch16 约2s 采温、手动模式(关闭/LED0/LED1/双闪)、≥45℃报警2Hz快闪且手动失效、降温恢复",
    "task3_key": "RTC 00:00:00 走时、长按设闹钟(短按切项/KEY_UP调值/超时退出)、备份寄存器掉电保持、闹钟中断触发迎宾10次、KEY_UP查询(LED0时/LED1分)",
    "gpio_pins": {"LED0": "PF9 低电平点亮", "LED1": "PF10 低电平点亮", "KEY0": "PE4 低电平有效", "KEY_UP": "PA0 高电平有效"},
    "thinking_questions": {
      "Q1": "掉电重启后恢复上次模式（记忆模式）：用 RTC 备份寄存器（需 VBAT 供电）或内部 Flash 保存当前模式编号，上电初始化时读取并切回该模式。",
      "Q2": "用信号量/事件标志理解状态切换：把每个模式当作一个事件标志位，状态切换=事件的发布/获取；按键触发即置位或清位对应标志，主循环按当前标志集合执行对应动作，实现与按键扫描解耦的状态机。"
    },
    "thinking_questions_by_task": {
      "task1": {"Q3": "迎宾闪烁次数可配置：在状态机中新增「配置态」——长按 KEY_UP 进入并递增次数写入配置变量（如 welcome_blink_count），迎宾模式按该变量闪烁，短按 KEY_UP 递增、再次长按确认退出。"},
      "task2": {"Q3": "避免 45℃ 临界抖动：采用滞回比较——升温到 48℃ 才进入报警、降温到 42℃ 才恢复，两个阈值之间保持当前状态，而非单一 45℃ 阈值频繁切换。"},
      "task3": {"Q3": "扩展多闹钟（工作日/周末）：把单个闹钟变量改为闹钟数组（结构体 {时,分,使能,工作日掩码}），状态机增加「选择闹钟」态，闹钟中断里遍历数组匹配当前时间与工作日掩码。"}
    },
    "thinking_question_ids": ["Q1", "Q2", "Q3"]
  },

