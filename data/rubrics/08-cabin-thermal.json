{
  "experiment_name": "智能座舱温控系统设计（新能源汽车工程实训·电子控制方向）",
  "experiment_code": "08_cabin_thermal",
  "course_name": "新能源汽车工程实训（电子控制方向）",
  "version": "1.0.0",
  "_scheme_note": "对齐《新能源汽车工程实训（电子控制方向）实施方案》考核方案（合计100分）：出勤与纪律10 + 子系统训练20 + 系统联调30 + 报告撰写20 + 答辩与规范10 + 进阶功能10。机器可评部分：报告20（关键词）+ 系统联调30的代码证据（编译10/非阻塞5/代码质量15）；其余为教师实测项（manual，默认分按方案折中给定，教师可在成绩册中调整）。",
  "thinking_check": false,

  "hardware_platform": {
    "mcu": "STM32F103C8T6（野火小智核心板）",
    "modules": ["DHT11", "光敏 ADC", "热敏 ADC", "OLED SSD1306(I2C)", "有源蜂鸣器", "TB6612FNG+风扇", "LED", "按键"],
    "toolchain": "arm-none-eabi-gcc + make（本仓 src/common-f1 框架；机房 Keil/CubeMX 亦可）"
  },

  "expected_sections": [
    ["1", ["实训日志", "过程记录", "现象记录"], "journal", 5],
    ["2", ["系统设计", "系统框图", "引脚表", "任务分工"], "system_design", 5],
    ["3", ["实现", "核心代码", "驱动", "感知", "决策", "执行"], "implementation", 5],
    ["4", ["测试", "调试", "数据记录", "问题与解决"], "test_analysis", 3],
    ["5", ["总结", "参考文献"], "summary", 2]
  ],

  "grading_scale": {
    "A": {"min": 90, "max": 100, "label": "优"},
    "B": {"min": 80, "max": 89.9, "label": "良"},
    "C": {"min": 70, "max": 79.9, "label": "中"},
    "D": {"min": 60, "max": 69.9, "label": "及格"},
    "F": {"min": 0, "max": 59.9, "label": "不及格"}
