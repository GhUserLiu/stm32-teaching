# Logs & Temporary
# ========================================
*.log
*.tmp
*.bak
*.cache
*.pid
*.seed
*.pid.lock
# 临时调试/诊断脚本（不纳入版本管理）
/debug_*.py
/temp_*.py

# ========================================
# OS Generated
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========================================
# Project Specific
# ========================================
# 学生提交的源代码（运行时数据，不入库；含解包后的 CubeMX 工程）
data/teaching/**/source/

# 学生原始提交压缩包（大文件，不入库）
data/teaching/**/*.zip
/*.汽服*.zip
/汽服*.zip

# 学生实验报告与系统生成结果（运行时产物，不入库；** 匹配 学期/班级/实验 任意深度）
data/teaching/**/reports/
# 结果目录通配：results/、results_backup*/、results_pre_rerun_* 等任意生成批次均含学生隐私。
# 历史教训（2026-08）：results_pre_rerun_20260629 逃逸旧 results/ 模式，151 个含学号姓名文件入库。
data/teaching/**/results*/
# 查重等处理后的中间结果（含学生姓名/学号，隐私数据，不入库）
data/teaching/**/processed/
# 课程档案（成绩单 PDF/任务书等，含学生隐私，不入库）
data/teaching/**/课程档案/
# 花名册/成绩册/成绩汇总 .xls(x)（含真实学号/姓名，隐私数据，不入库）。
# 任意深度：docs/ 子目录下的成绩册曾逃逸旧的一级目录模式（2026-08 二次扫描发现）
data/teaching/**/*.xlsx
data/teaching/**/*.xls
data/teaching/*/*.html
# 查重分组名单（内容含学号+姓名，隐私数据，不入库）
data/teaching/**/plagiarism_groups*.txt

# Outputs（运行时输出目录整体不入库；历史教训：按扩展名枚举漏掉 .md 等格式）
outputs/

# 运行时数据库（persistence 层，SQLite 本地库不入库；*.sqlite* 连带
# 覆盖 -wal/-shm/-journal 边车文件——崩溃残留的热日志同样含学生数据）
database/*.sqlite*

# CubeMX 厂商库（DSP/NN 信号/神经网络库，体积大且 .ioc 可重新生成，不入库）
src/projects/*/cubemx/Drivers/CMSIS/DSP/
src/projects/*/cubemx/Drivers/CMSIS/NN/

# Keil DFP 器件支持包（EIDE/Keil 本地构建用，按机器安装，不入库）
/.pack/

# Model files (large)
models/*.pkl
models/*.h5
models/*.pt

# ========================================
# EIDE Template
# ========================================
*.ept
*.eide-template

# Stray Excel/report artifacts written to CWD by teaching_scripts (should go to outputs/)
src/tools/*.xlsx

# 本地临时测试文件（不入库）
/测试.txt

# Keil/EIDE 自动生成的 RTE 头文件（构建时再生，不入库）
/RTE_Components.h

# 一次性重跑/诊断脚本（如下划线前缀的 rerun 脚本，不入库）
scripts/_*.py

# 本地环境变量（机器相关路径/密钥，不入库；模板见 .env.example）
.env
